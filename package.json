{
  "name": "residue-cleaner",
  "version": "0.3.0-alpha.0",
  "description": "Residue — CLI cleaner and evidence-first auditor for developer caches, CLI installs and AI runtime leftovers; shows what each folder is before anything is deleted",
  "type": "module",
  "license": "MIT",
  "author": "Residue contributors",
  "keywords": [
    "residue",
    "residue-cleaner",
    "cli-cleaner",
    "cli-temizleyici",
    "cli-tools",
    "cli-cache",
    "developer-tools",
    "devtools",
    "cache-analyzer",
    "disk-usage",
    "ai-agents",
    "ai-tools",
    "ai-artifacts",
    "npm-cache",
    "nuget",
    "conda",
    "python",
    "onnx",
    "cuda",
    "nodejs",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omer-denen/residue-cleaner.git"
  },
  "homepage": "https://github.com/omer-denen/residue-cleaner#readme",
  "bugs": {
    "url": "https://github.com/omer-denen/residue-cleaner/issues"
  },
  "os": [
    "win32"
  ],
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "residue": "./bin/residue.mjs",
    "residue-cleaner": "./bin/residue.mjs"
  },
  "scripts": {
    "scan": "tsx src/cli.ts scan",
    "ui": "tsx src/cli.ts ui",
    "api": "tsx src/cli.ts api",
    "inventory": "tsx src/cli.ts inventory",
    "clean": "tsx src/cli.ts clean",
    "explain": "tsx src/cli.ts explain",
    "rules": "tsx src/cli.ts rules",
    "doctor": "tsx src/cli.ts doctor",
    "undo": "tsx src/cli.ts undo",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node scripts/smoke-web.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "build:web": "vite build",
    "prepublishOnly": "npm run build:web && npm run typecheck",
    "preversion": "npm run typecheck",
    "release:patch": "npm version patch -m \"surum: v%s\"",
    "release:minor": "npm version minor -m \"surum: v%s\"",
    "release:major": "npm version major -m \"surum: v%s\"",
    "start": "tsx src/cli.ts",
    "status": "tsx src/cli.ts status",
    "log": "tsx src/cli.ts log",
    "init-state": "tsx scripts/init-state.ts"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "private": true
}
